{
	"name": "npad",
	"version": "1.146.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "NPad: a lightweight standalone local text editor for Windows, Linux, and macOS.",
	"author": "Sahitya Patel",
	"homepage": "https://github.com/sahitya0000/NPad#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sahitya0000/NPad.git"
	},
	"bugs": {
		"url": "https://github.com/sahitya0000/NPad/issues"
	},
	"packageManager": "pnpm@12.16.0",
	"engines": {
		"node": ">=24.22.1 <25"
	},
	"main": "./out-npad/main.js",
	"nativeBuild": {
		"runtime": "electron",
		"target": "43.8.6",
		"disturl": "https://electronjs.org/headers",
		"msBuildId": "15893748",
		"buildFromSource": true
	},
	"scripts": {
		"typecheck": "tsc6 --project build/tsconfig.json",
		"check": "pnpm run typecheck && pnpm test && pnpm run test-docs",
		"bundle": "node build/npad/bundle.ts",
		"bundle-npad": "node build/npad/bundle.ts",
		"package-npad": "node build/npad/package.ts",
		"build-npad": "node build/npad/build.ts",
		"build": "node build/npad/build.ts",
		"test": "node --test build/next/test/npad.test.ts build/npad/test/platform.test.ts build/npad/test/installer.test.ts build/npad/test/standalone.test.ts build/npad/test/textTools.test.ts build/npad/test/spelling.test.ts",
		"test-npad-app": "node --test build/npad/test/smoke.test.ts",
		"test-native-app": "node --test build/npad/test/native.test.ts",
		"test-docs": "node --test build/npad/test/documentation.test.ts",
		"benchmark-startup": "node build/npad/benchmark-startup.ts",
		"electron": "node build/npad/electron.ts"
	},
	"dependencies": {
		"@microsoft/1ds-core-js": "^3.2.13",
		"@microsoft/1ds-post-js": "^3.2.13",
		"@microsoft/dev-tunnels-connections": "^1.3.61",
		"@microsoft/dev-tunnels-management": "^1.3.61",
		"@parcel/watcher": "^2.5.6",
		"@vscode/deviceid": "^0.1.1",
		"@vscode/diff": "0.0.2-122",
		"@vscode/iconv-lite-umd": "0.7.1",
		"@vscode/os-proxy-resolver": "^0.4.0",
		"@vscode/policy-watcher": "^1.7.0",
		"@vscode/proxy-agent": "^0.45.0",
		"@vscode/ripgrep-universal": "^1.18.0",
		"@vscode/spdlog": "^0.15.8",
		"@vscode/sqlite3": "5.1.12-vscode",
		"@vscode/sudo-prompt": "9.3.2",
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"@vscode/vscode-languagedetection": "1.0.23",
		"@vscode/windows-mutex": "^0.5.0",
		"@vscode/windows-process-tree": "^0.8.0",
		"@vscode/windows-registry": "^1.3.0",
		"chrome-remote-interface": "^0.33.0",
		"dictionary-en": "^4.0.0",
		"http-proxy-agent": "^7.0.0",
		"https-proxy-agent": "^7.0.2",
		"jschardet": "3.1.4",
		"kerberos": "2.1.1",
		"minimist": "^1.2.8",
		"native-is-elevated": "0.9.0",
		"native-keymap": "^3.3.5",
		"nspell": "^2.1.5",
		"open": "^10.1.2",
		"playwright-core": "1.61.0-alpha-2026-06-04",
		"undici": "^7.28.0",
		"vscode-oniguruma": "1.7.0",
		"vscode-regexpp": "^3.1.0",
		"vscode-textmate": "^9.3.2",
		"ws": "^8.19.0",
		"yauzl": "^3.3.1",
		"yazl": "^2.4.3"
	},
	"devDependencies": {
		"@electron/get": "^2.0.0",
		"@types/node": "24.x",
		"@types/nspell": "^2.1.6",
		"@types/svgo": "2.6.4",
		"@vscode/codicons": "^0.0.46-49",
		"asar": "^3.0.3",
		"esbuild": "0.27.2",
		"extract-zip": "^2.0.1",
		"innosetup": "^6.4.1",
		"node-gyp": "^13.1.0",
		"rcedit": "^1.1.0",
		"source-map": "0.6.1",
		"svgo": "2.8.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"optionalDependencies": {
		"windows-foreground-love": "0.6.1"
	}
}
